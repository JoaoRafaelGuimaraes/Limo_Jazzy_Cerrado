Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Livox MID-360
      Enabled: true
      Topic:
        Value: /livox/lidar
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: RealSense cor
      Enabled: true
      Topic:
        Value: /camera/camera/color/image_raw
    - Class: rviz_default_plugins/PointCloud2
      Name: RealSense nuvem
      Enabled: false
      Topic:
        Value: /camera/camera/depth/color/points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
    - Class: rviz_default_plugins/LaserScan
      Name: Scan 2D (T-mini Pro)
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 60; 60
    # --- DEM do terrain_modelling -------------------------------------------
    # Superficie: altura da camada 'elevation', cor pela 'variance'.
    # QoS Best Effort para casar com o SensorDataQoS do publisher; um assinante
    # Reliable nao recebe nada de um publisher Best Effort.
    # Bounds de intensidade fixas de proposito: o prior da variancia e 1e4, e o
    # autocompute jogaria todas as celulas observadas no mesmo extremo do arco-iris.
    - Class: grid_map_rviz_plugin/GridMap
      Name: DEM (elevation x variance)
      Enabled: true
      Topic:
        Value: /terrain/obstacle_points_hag
        Reliability Policy: Best Effort
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Color Transformer: IntensityLayer
      Color Layer: variance
      Use Rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 1
      Show Grid Lines: false
      Alpha: 1
      History Length: 1
    # --- saidas do ground_segmentation ---------------------------------------
    - Class: rviz_default_plugins/PointCloud2
      Name: Chao (ground_segmentation)
      Enabled: true
      Topic:
        Value: /ground_segmentation/ground_points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 80; 200; 80
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstaculos (ground_segmentation)
      Enabled: true
      Topic:
        Value: /ground_segmentation/obstacle_points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 160; 40
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometria de rodas
      Enabled: true
      Topic:
        Value: /odom
      Keep: 200
      Shape:
        Value: Arrow
      Covariance:
        Value: false
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 0.6
      Yaw: 2.4
      Target Frame: base_footprint
Window Geometry:
  Height: 900
  Width: 1400
