<?xml version="1.0"?>
<sdf version="1.9">
  <world name="cerrado">
    <!--
      Cerrado 32 x 32 m (68 arvores) para robo terrestre (LIMO Pro).
      Terreno em malha com relevo de 0 a 2,7 m (x/y em [-16, 16]); nao ha chao fora do quadrado.
      Modelo: model://cerrado_32x32_limo, casca que usa as malhas de model://cerrado_32x32 (GZ_SIM_RESOURCE_PATH e ajustado pelo launch).
    -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.38 0.40 0.43 1</ambient>
      <background>0.66 0.78 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.91 0.80 1</diffuse>
      <specular>0.12 0.12 0.10 1</specular>
      <direction>-0.45 0.35 -0.82</direction>
      <attenuation><range>1000</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>

    <include>
      <uri>model://cerrado_32x32_limo</uri>
      <name>cerrado</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
